@startuml ContextDiagram

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

' Пользователь, управляющий умным домом
Person(user, "Пользователь", "Владелец дома, использует веб-интерфейс для управления отоплением и просмотра температуры")

' Система, которую мы разрабатываем — текущий монолит
System(system, "Умный дом", "Монолитное приложение для управления отоплением и получения температуры от устройств")

' Внешние системы — отопительное оборудование в домах
System_Ext(device, "Система отопления (Дом 1, 2, ..., N)", "Физическое устройство управления отоплением")

' Взаимодействия
Rel(user, system, "Управляет системой отопления\nи просматривает температуру", "Web-интерфейс (HTTPS)")
Rel(system, device, "Отправляет команды и запрашивает температуру")

@enduml