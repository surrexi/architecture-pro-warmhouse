@startuml C4_Code_TelemetryFlow

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml
LAYOUT_WITH_LEGEND()

title Поток телеметрии: Устройство → DeviceGateway → Kafka

System_Ext(device, "Устройство (датчик)", "Отправляет данные телеметрии")
Container(gateway, "Device Gateway Service", "Go", "Обрабатывает телеметрию от устройств")
ContainerQueue(kafka, "Kafka", "Брокер сообщений")
Container_Boundary(gateway, "Device Gateway Service", "Go") {
    Component(receiver, "TelemetryReceiver", "Получает телеметрию от устройств (MQTT/HTTP)")
    Component(validator, "PayloadValidator", "Проверка формата и структуры данных")
    Component(kafkaPublisher, "KafkaPublisher", "Публикует сообщения в Kafka")
}

Rel(device, receiver, "Отправка данных", "MQTT / HTTP")
Rel(receiver, validator, "Проверка данных")
Rel(validator, kafkaPublisher, "Передача валидных данных")
Rel(kafkaPublisher, kafka, "Публикация в топик telemetry")

@enduml